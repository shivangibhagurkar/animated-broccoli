right join department d
on s.dept_id = d.dept_id;

-- joining reservations to rooms
select * from reservations r1
left join rooms r2
on r1.room_id = r2.room_id;

-- reservations to staff ( who handled the booking )
select r.res_id, r.res_name, s.name, g.guest_id, s.contact
from reservations r 
inner join guests g 
on r.guest_id = g.guest_id
inner join staff s 
on r.staff_id = s.staff_id;


-- subqueries
-- 1. who has the most expensive room?
SELECT g_name 
FROM guests 
WHERE guest_id IN (
    SELECT guest_id 
    FROM reservations 
    WHERE room_id IN (
        SELECT room_id 
        FROM rooms 
        WHERE rent = (SELECT MAX(rent) FROM Rooms)
    )
);

-- staff with more than average salary
SELECT name, salary
FROM staff
WHERE salary > (SELECT AVG(salary) FROM staff);

-- rooms more expensive than average
SELECT room_id, rent
FROM rooms
WHERE rent > (SELECT AVG(rent) FROM rooms);

select avg(rent) from rooms;

-- subquery How many rooms are available in a given hotel?
SELECT COUNT(*) AS available_rooms
FROM Rooms
WHERE status = 'vacant';

-- available vacant rooms grouped by type
SELECT 
    r_type, COUNT(*) AS available_count
FROM
    Rooms
WHERE
    status = 'vacant'
GROUP BY r_type;

-- grouped along with room numbers 
SELECT 
    r_type, GROUP_CONCAT(room_id) AS available_rooms
FROM
    Rooms
WHERE
    status = 'vacant'
GROUP BY r_type;

-- revenue per room type
SELECT 
    rm.r_type, SUM(rm.rent) AS total_revenue
FROM
    Reservations res
        JOIN
    Rooms rm ON res.room_id = rm.room_id
GROUP BY rm.r_type
ORDER BY total_revenue DESC;

-- most expensive rooms
SELECT g.g_name AS Guest, r.room_id, rm.r_type, rm.rent
FROM Guests g
JOIN Reservations r ON g.guest_id = r.guest_id
JOIN Rooms rm ON r.room_id = rm.room_id
WHERE rm.rent = (
    SELECT MAX(rent)
    FROM Rooms
);

